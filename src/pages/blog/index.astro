---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BlogCalendar from '../../components/BlogCalendar.astro';
import { toDateKey } from '../../lib/calendar';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1200px;
			}
			.blog-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2rem; align-items: start; }
			.blog-list, .blog-sidebar { min-width: 0; }
			.blog-sidebar { position: sticky; top: 1rem; }
			h1 { font-size: 2rem; }
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li.featured {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li.featured img {
				width: 100%;
			}
			ul li.featured .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 1024px) {
				.blog-layout { grid-template-columns: minmax(0, 1fr); }
				.blog-sidebar { position: static; grid-row: 1; }
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li.featured {
					margin-bottom: 0;
				}
				ul li.featured .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main data-blog-archive>
			<h1>博客归档</h1>
			<div class="blog-layout">
			<section class="blog-list" aria-label="文章列表">
				<p id="archive-summary" role="status">全部文章 · {posts.length} 篇</p>
				<a href="/blog/" data-all-years hidden>查看全部文章</a>
				<p id="empty-posts" hidden={posts.length !== 0}>暂无文章。</p>
				<ul id="post-list">
					{
						posts.map((post, index) => (
							<li data-post-date={toDateKey(post.data.pubDate)} class:list={{ featured: index === 0 }}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && <img width={720} height={360} src={post.data.heroImage} alt="" />}
									<h2 class="title">{post.data.title}</h2>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<aside class="blog-sidebar" aria-labelledby="calendar-heading">
				<BlogCalendar dates={posts.map((post) => post.data.pubDate)} />
			</aside>
			</div>
		</main>
		<Footer />
		<script>
			import '../../scripts/blog-archive';
		</script>
	</body>
</html>
