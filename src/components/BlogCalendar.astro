---
import {
  toDateKey, generateCalendarData, generateMonthSegments,
  getColorLevel, countContributionsForYear,
} from '../lib/calendar';

interface Props {
  dates: Date[];
}

const { dates } = Astro.props;
const years = [...new Set(dates.map((date) => date.getUTCFullYear()))].sort((a, b) => b - a);
const initialYear = years[0] ?? new Date().getUTCFullYear();
const counts: Record<string, number> = {};
for (const date of dates) {
  const key = toDateKey(date);
  counts[key] = (counts[key] ?? 0) + 1;
}
const weeks = generateCalendarData(initialYear);
---

<div class="github-calendar" id="github-calendar" data-initial-year={initialYear}>
  <div class="calendar-header">
    <div>
      <h2 id="calendar-heading">创作日历</h2>
      <p id="calendar-summary">{initialYear} 年 · {countContributionsForYear(counts, initialYear)} 篇文章</p>
    </div>
    <div id="year-controls" class="year-selector" hidden>
      <label for="year" class="sr-only">筛选年份</label>
      <button type="button" id="prev-year" aria-label="上一有文章年份" title="上一有文章年份">‹</button>
      <select id="year" name="year" aria-controls="post-list">
        <option value="">全部年份</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
      <button type="button" id="next-year" aria-label="下一有文章年份" title="下一有文章年份">›</button>
    </div>
  </div>
  <div class="calendar-scroll" role="region" aria-label="全年创作日历，可横向滚动" aria-describedby="calendar-help" tabindex="0">
    <div class="calendar-layout" style={`--weeks: ${weeks.length}`}>
      <div class="calendar-months" id="calendar-months" aria-hidden="true">
        {generateMonthSegments(weeks).map((month) => (
          <span style={`grid-column: span ${month.span}`}>{month.label}</span>
        ))}
      </div>
      <div class="calendar-weekdays" aria-hidden="true">
        {['一', '', '三', '', '五', '', ''].map((label) => <span>{label}</span>)}
      </div>
      <div class="calendar-grid" id="calendar-grid">
        {weeks.flat().map((date) => {
          const key = date ? toDateKey(date) : '';
          const count = counts[key] ?? 0;
          const label = `${key}：${count} 篇文章`;
          return count > 0 ? (
            <a class={`calendar-day level-${getColorLevel(count)}`} data-date={key} data-count={count}
              href={`?year=${initialYear}&date=${key}#post-results`}
              title={label} aria-label={`${label}，查看当天文章`} />
          ) : (
            <span class="calendar-day level-0" data-date={key || undefined}
              data-count={date ? 0 : undefined} title={date ? label : undefined}
              aria-label={date ? label : undefined} aria-hidden={date ? undefined : 'true'} />
          );
        })}
      </div>
    </div>
  </div>
  <div class="calendar-footer">
    <p id="calendar-help">点击绿色方块，查看当天文章</p>
    <div class="calendar-legend" aria-label="颜色越深，当天文章越多">
      少 {[0, 1, 2, 3, 4].map((level) => <span class={`calendar-day level-${level}`} aria-hidden="true" />)} 多
    </div>
  </div>
  <div id="calendar-tooltip" class="calendar-tooltip" role="tooltip" hidden></div>
  <noscript><p>启用 JavaScript 后可按年份和日期筛选；下方仍可阅读全部文章。</p></noscript>
</div>

<style is:global>
  .github-calendar {
    --cell-size: 12px;
    --cell-gap: 4px;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--surface-color);
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.5;
  }
  .github-calendar .calendar-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
  .github-calendar h2 { margin: 0; font-size: 1.125rem; font-weight: 600; }
  .github-calendar #calendar-summary { margin: 0.35rem 0 0; color: var(--muted-color); }
  .github-calendar .year-selector:not([hidden]) { display: flex; gap: 0.35rem; align-items: center; }
  .github-calendar .year-selector select, .github-calendar .year-selector button {
    box-sizing: border-box;
    min-height: 36px;
    font: inherit;
    padding: 0.35rem 0.65rem;
    color: var(--text-color);
    background: var(--control-bg-color);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }
  .github-calendar .year-selector button { width: 36px; font-size: 22px; line-height: 1; }
  .github-calendar .year-selector button:not(:disabled) { cursor: pointer; }
  .github-calendar .year-selector button:not(:disabled):hover { background: var(--hover-color); }
  .github-calendar .year-selector button:disabled { opacity: 0.4; }
  .github-calendar .calendar-scroll { overflow-x: auto; padding: 3px; scrollbar-width: thin; }
  .github-calendar .calendar-layout { display: grid; grid-template-columns: 1.5rem max-content; gap: 6px; width: max-content; padding: 3px; }
  .github-calendar .calendar-months, .github-calendar .calendar-grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), var(--cell-size));
    gap: var(--cell-gap);
    grid-column: 2;
  }
  .github-calendar .calendar-months { font-size: 12px; }
  .github-calendar .calendar-grid { grid-template-rows: repeat(7, var(--cell-size)); grid-auto-flow: column; }
  .github-calendar .calendar-weekdays { display: grid; grid-template-rows: repeat(7, var(--cell-size)); gap: var(--cell-gap); font-size: 11px; line-height: var(--cell-size); }
  .github-calendar .calendar-day { display: block; box-sizing: border-box; width: var(--cell-size); height: var(--cell-size); border-radius: 2px; box-shadow: inset 0 0 0 1px var(--calendar-cell-border); }
  .github-calendar a.calendar-day { cursor: pointer; text-decoration: none; }
  .github-calendar a.calendar-day:hover, .github-calendar a.calendar-day:focus-visible,
  .github-calendar a.calendar-day[aria-current="date"] { outline: 2px solid var(--calendar-outline); outline-offset: 1px; }
  .github-calendar .calendar-grid [aria-hidden="true"] { visibility: hidden; }
  .github-calendar .level-0 { background: var(--calendar-level-0); }
  .github-calendar .level-1 { background: var(--calendar-level-1); }
  .github-calendar .level-2 { background: var(--calendar-level-2); }
  .github-calendar .level-3 { background: var(--calendar-level-3); }
  .github-calendar .level-4 { background: var(--calendar-level-4); }
  .github-calendar .calendar-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; color: var(--muted-color); font-size: 12px; }
  .github-calendar #calendar-help { margin: 0; }
  .github-calendar .calendar-legend { display: flex; align-items: center; gap: 4px; }
  .github-calendar .calendar-tooltip { position: fixed; z-index: 30; max-width: calc(100vw - 2rem); box-sizing: border-box; padding: 0.45rem 0.65rem; border-radius: 6px; background: var(--tooltip-background); color: var(--tooltip-color); font-size: 12px; pointer-events: none; box-shadow: 0 2px 8px rgba(var(--shadow-color), 0.2); }
  @media (max-width: 640px) {
    .github-calendar { --cell-size: 14px; padding: 1rem; }
    .github-calendar .calendar-header { align-items: flex-start; flex-wrap: wrap; gap: 0.75rem; }
    .github-calendar .calendar-footer { gap: 0.5rem; }
  }
</style>
